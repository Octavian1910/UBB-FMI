     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ;Se dau 2 siruri de octeti A si B. Sa se construiasca sirul R care sa contina elementele lui B in ordine inversa urmate de elementele in ordine inversa ale lui A.
     4                                  
     5                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     6                                  global start        
     7                                  
     8                                  ; declare external functions needed by our program
     9                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
    10                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
    11                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    12                                  
    13                                  ; our data is declared here (the variables needed by our program)
    14                                  segment data use32 class=data
    15                                      ; ...
    16 00000000 0201FD00                    a db 2,1,-3,0
    17                                      la equ $-a
    18 00000004 040507060201                b db 4, 5, 7, 6, 2, 1
    19                                      lb equ $-b
    20 0000000A 00<rept>                    d times la+lb db 0
    21                                      
    22                                       
    23                                      ;R: 1, 2, 6, 7, 5, 4, 0, -3, 1, 2
    24                                  
    25                                  ; our code starts here
    26                                  segment code use32 class=code
    27                                      start:
    28                                          ; ...
    29 00000000 B906000000                      mov ecx,lb ;cate elemente are de parcurs
    30 00000005 BF00000000                      mov edi,0 ;indicele cu care parcurgem d
    31 0000000A BE[09000000]                    mov esi,b+lb-1 ; incepem de la finalul sirului b
    32 0000000F E30C                            jecxz urm_pas
    33                                          mutaB:
    34 00000011 8A06                                mov al,[esi]    ;mutam in al valoarea din sirul b
    35 00000013 8887[0A000000]                      mov [d+edi],al  ;mutam in d valoarea din sirul b
    36 00000019 4E                                  dec esi         ;mergem cu indexul la elementul din stanga in b
    37 0000001A 47                                  inc edi         ;crestem indexul unde vom adauga urm valoare in d
    38 0000001B E2F4                                loop mutaB      ;scadem ecx
    39                                          
    40                                          urm_pas:
    41 0000001D B904000000                      mov ecx,la ;cate elemente are de parcurs
    42 00000022 BE[03000000]                    mov esi,a+la-1 ; incepem de la finalul sirului a
    43 00000027 E30C                            jecxz finish
    44                                          mutaA:
    45 00000029 8A06                                mov al,[esi]    ;mutam in al valoarea din sirul a
    46 0000002B 8887[0A000000]                      mov [d+edi],al  ;mutam in d valoarea din sirul a
    47 00000031 4E                                  dec esi         ;mergem cu indexul la elementul din stanga in a
    48 00000032 47                                  inc edi         ;crestem indexul unde vom adauga urm valoare in d
    49 00000033 E2F4                                loop mutaA      ;scadem ecx
    50                                          
    51                                          finish:
    52 00000035 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    53 00000037 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
