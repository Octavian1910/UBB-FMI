     1                                  ;Se da dublucuvantul M. Sa se obtina dublucuvantul MNew astfel:
     2                                  ;bitii 0-3 a lui MNew sunt identici cu bitii 5-8 a lui M
     3                                  ;bitii 4-7 a lui MNew au valoarea 1
     4                                  ;bitii 27-31 a lui MNew au valoarea 0
     5                                  ;bitii 8-26 din MNew sunt identici cu bitii 8-26 a lui M.
     6                                  
     7                                  
     8                                  bits 32 ; assembling for the 32 bits architecture
     9                                  
    10                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
    11                                  global start        
    12                                  
    13                                  ; declare external functions needed by our program
    14                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
    15                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
    16                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    17                                  
    18                                  ; our data is declared here (the variables needed by our program)
    19                                  segment data use32 class=data
    20                                      ; ...
    21                                        
    22 00000000 4D3C2B1A                    m dd 00011010001010110011110001001101b  
    23 00000004 <res 00000004>              mNew resd 1
    24                                         
    25                                  ; our code starts here
    26                                  segment code use32 class=code
    27                                      start:
    28                                          ; ...
    29 00000000 BB00000000                      mov ebx,0 ; in ebx tinem rezultatul deci il facem 0
    30                                          
    31 00000005 A1[00000000]                    mov eax,[m]  ;folosim eax pentru a lucra cu a
    32 0000000A B9E0010000                      mov ecx,000000000000000000000000111100000b
    33 0000000F 21C8                            and eax,ecx ;izolam bitii de pe pozitiile 5-8
    34 00000011 B105                            mov cl,5 
    35 00000013 D3E8                            shr eax,cl ;mutam bitii sa fie pe pozitiile 0-3
    36                                          
    37 00000015 09C3                            or ebx,eax ;mutam rezultatul in ebx
    38                                          
    39 00000017 81CBF0000000                    or ebx,000000000000000000000000011110000b ;bitii 4-7 a lui MNew au valoarea 1
    40                                          
    41 0000001D 81E3FFFFFF07                    and ebx,00000111111111111111111111111111b;bitii 27-31 a lui MNew au valoarea 0
    42                                          
    43 00000023 A1[00000000]                    mov eax, [m]
    44 00000028 2500FFFF07              and eax, 00000111111111111111111100000000b
    45 0000002D 09C3                    or ebx, eax
    46                                          ;022B3CF2
    47 0000002F 891D[04000000]                  mov [mNew],ebx
    48                                          
    49                                          
    50                                          
    51                                          
    52                                          
    53                                          
    54                                          ; exit(0)
    55 00000035 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    56 00000037 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
