    32 00000000 68[08000000]                    push dword mesaj1
    33 00000005 FF15[00000000]                  call [printf]
    34 0000000B 83C404                          add esp,4*1
    35                                          
    36                                          ;citim primul nr scanf(%d,&a)
    37 0000000E 68[00000000]                    push dword a
    38 00000013 68[5D000000]                    push format
    39 00000018 FF15[00000000]                  call [scanf]
