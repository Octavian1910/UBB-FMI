     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit,printf,scanf               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                                            
    11                                  import printf msvcrt.dll
    12                                  import scanf msvcrt.dll 
    13                                  
    14                                  ; our data is declared here (the variables needed by our program)
    15                                  segment data use32 class=data
    16                                      ; ...
    17                                      ; ;Sa se citeasca de la tastatura in baza 16 doua numere a si b de tip dword si sa se afiseze suma partilor low si diferenta partilor high. Exemplu:
    18                                      ; a = 00101A35h, b = 00023219h
    19                                      ; suma = 4C4Eh
    20                                      ; diferenta = Eh
    21 00000000 00000000                    a dd 0
    22 00000004 00000000                    b dd 0
    23 00000008 257820257800                format db "%x %x" , 0
    24 0000000E 53756D61203D202578-         mesaj1 db "Suma = %x " , 0
    24 00000017 2000               
    25 00000019 4469666572656E7461-         mesaj2 db "Diferenta = %x " , 0
    25 00000022 203D2025782000     
    26                                  ; our code starts here
    27                                  segment code use32 class=code
    28                                      start:
    29                                          ; ...
    30                                          
    31                                          ;scanf(format , a , b)
    32 00000000 68[04000000]                    push b
    33 00000005 68[00000000]                    push a
    34 0000000A 68[08000000]                    push format
    35 0000000F FF15[00000000]                  call [scanf]
    36 00000015 83C40C                          add esp,4*3
    37                                          
    38 00000018 A1[00000000]                    mov eax,[a]
    39 0000001D 8B1D[04000000]                  mov ebx,[b]
    40                                  
    41                                          
    42 00000023 6601D8                          add ax,bx
    43 00000026 98                              cwde 
    44                                          ;printf(suma , al )
    45 00000027 50                              push eax
    46 00000028 68[0E000000]                    push mesaj1
    47 0000002D FF15[00000000]                  call [printf]
    48 00000033 83C408                          add esp,4*2
    49                                          
    50                                          
    51 00000036 A1[00000000]                    mov eax,[a]
    52 0000003B 8B1D[04000000]                  mov ebx,[b]
    53                                          
    54 00000041 50                              push eax 
    55 00000042 6658                            pop ax
    56 00000044 665A                            pop dx
    57 00000046 53                              push ebx 
    58 00000047 665B                            pop bx
    59 00000049 6659                            pop cx
    60                                          
    61                                          
    62 0000004B 6629CA                          sub dx,cx
    63 0000004E 0FBFD2                          movsx edx,dx
    64                                          
    65                                          ;printf(diferenta , bl )
    66 00000051 52                              push edx
    67 00000052 68[19000000]                    push mesaj2
    68 00000057 FF15[00000000]                  call [printf]
    69 0000005D 83C408                          add esp,4*2
    70                                        
    71                                      
    72                                          ; exit(0)
    73 00000060 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    74 00000062 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
