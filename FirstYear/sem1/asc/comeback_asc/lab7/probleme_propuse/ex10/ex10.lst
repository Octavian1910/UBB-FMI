     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit,printf,scanf               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                  import printf msvcrt.dll
    11                                  import scanf msvcrt.dll
    12                                                            
    13                                  ; our data is declared here (the variables needed by our program)
    14                                  segment data use32 class=data
    15                                      ; ...
    16                                      ;Sa se citeasca de la tastatura un numar in baza 10 si sa se afiseze valoarea acelui numar in baza 16.
    17                                      ;Exemplu: Se citeste: 28; se afiseaza: 1C
    18                                  
    19 00000000 0000                        numar dw 0
    20                                      
    21 00000002 4E756D6172756C2069-         mesaj1 db "Numarul in baza 10 este ",0
    21 0000000B 6E2062617A61203130-
    21 00000014 20657374652000     
    22 0000001B 256400                      format_b10 db "%d",0
    23 0000001E 257800                      format_b16 db "%x",0
    24                                      
    25                                      
    26                                      
    27                                  ; our code starts here
    28                                  segment code use32 class=code
    29                                      start:
    30                                          ; ...
    31                                          
    32                                          ;printf
    33 00000000 68[02000000]                    push mesaj1
    34 00000005 FF15[00000000]                  call [printf]
    35 0000000B 83C404                          add esp,4*1
    36                                          
    37                                          ;scanf 
    38 0000000E 68[00000000]                    push numar
    39 00000013 68[1B000000]                    push format_b10
    40 00000018 FF15[00000000]                  call [scanf]
    41 0000001E 83C408                          add esp,4*2
    42                                          
    43                                          ;printf
    44 00000021 FF35[00000000]                  push dword [numar]
    45 00000027 68[1E000000]                    push format_b16
    46 0000002C FF15[00000000]                  call [printf]
    47 00000032 83C408                          add esp,4*2
    48                                          
    49                                          
    50                                          
    51                                          
    52                                          
    53                                          ; exit(0)
    54 00000035 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    55 00000037 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
