    35 00000000 68[0B000000]                    push dword mesaj2
    36 00000005 FF15[00000000]                  call [printf]
    37 0000000B 83C404                          add esp,4*1
    38                                          
    39                                          ;scanf
    40 0000000E 68[04000000]                    push dword b
    41 00000013 68[13000000]                    push dword format
    42 00000018 FF15[00000000]                  call [scanf]
    43 0000001E 83C408                          add esp,4*2
    44                                          
    45                                          
    46                                          
