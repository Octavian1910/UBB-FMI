    48                                          ;pune a in dx : ax
    49 00000021 66FF35[02000000]                push word [a+2]
    50 00000028 66FF35[00000000]                push word [a]
    51 0000002F 6658                            pop ax
    52 00000031 665A                            pop dx
    53 00000033 66F73D[04000000]                idiv word [b] ; ax = dx:ax / b dx = dx:ax % b
    54                                      
    55 0000003A 0FBFC0                          movsx eax,ax
    56 0000003D 0305[00000000]                  add eax,[a] ;eax = a + a/b
    57 00000043 A3[16000000]                    mov [rezultat] , eax
