     1                                  
     2                                  ;Se cere se se citeasca numerele a, b si c ; sa se calculeze si sa se afiseze a+b-c.
     3                                  bits 32 
     4                                  global start        
     5                                  
     6                                  
     7                                  extern exit,scanf,printf             
     8                                  import exit msvcrt.dll  
     9                                  import scanf msvcrt.dll  
    10                                  import printf msvcrt.dll  
    11                                    
    12                                                            
    13                                  extern calcul
    14                                  
    15                                  segment data use32 class=data
    16 00000000 61203D202564206220-         format db "a = %d b = %d c  = %d ",0
    16 00000009 3D202564206320203D-
    16 00000012 2025642000         
    17 00000017 61202B2062202D2063-         rezultat db "a + b - c  = %d ",0
    17 00000020 20203D2025642000   
    18 00000028 0C000000                    a dd 12
    19 0000002C 0A000000                    b dd 10
    20 00000030 02000000                    c dd 2
    21                                      
    22                                  
    23                                  segment code use32 class=code
    24                                      start:
    25                                      
    26                                          ;citim numerele
    27                                          ;scanf(format,a,b,c)
    28 00000000 FF35[30000000]                  push dword [c]
    29 00000006 FF35[2C000000]                  push dword [b]
    30 0000000C FF35[28000000]                  push dword [a]
    31 00000012 68[00000000]                    push format
    32 00000017 FF15[00000000]                  call [scanf]
    33 0000001D 83C410                          add esp,4*4
    34                                          
    35                                          ;le trimitem in functie
    36                                          ;calcu;(a,b,c)
    37 00000020 FF35[30000000]                  push dword [c]
    38 00000026 FF35[2C000000]                  push dword [b]
    39 0000002C FF35[28000000]                  push dword [a]
    40 00000032 E8(00000000)                    call calcul
    41 00000037 83C40C                          add esp,4*3
    42                                          
    43                                          ;afisam rezultatul
    44                                          ;printf(format,eax)
    45 0000003A 50                              push eax
    46 0000003B 68[17000000]                    push rezultat
    47 00000040 FF15[00000000]                  call [printf]
    48 00000046 83C408                          add esp,4*2
    49                                          
    50 00000049 6A00                            push    dword 0     
    51 0000004B FF15[00000000]                  call    [exit]       
