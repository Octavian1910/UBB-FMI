     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                  
    11                                  ; our data is declared here (the variables needed by our program)
    12                                  segment data use32 class=data
    13                                      ; ...
    14                                      ;[b*c-(e+f)]/(a+d)
    15 00000000 78                          a db 120
    16 00000001 7C                          b db 124
    17 00000002 0F                          c db 15
    18 00000003 0C                          d db 12
    19                                      
    20 00000004 0C00                        e dw 12
    21 00000006 E701                        f dw 487
    22                                  
    23                                  ; our code starts here
    24                                  segment code use32 class=code
    25                                      start:
    26                                          ; ...
    27                                          ;b*c
    28 00000000 A0[01000000]                    mov al,[b]
    29 00000005 F625[02000000]                  mul byte [c] ; ax = al * c = b * c
    30                                          
    31 0000000B 668B1D[04000000]                mov bx,[e]
    32 00000012 66031D[06000000]                add bx,[f] ; bx = e + f
    33                                          
    34 00000019 6629D8                          sub ax,bx ; ax = ax - bx = b*c - (e + f)
    35                                          
    36 0000001C 8A1D[00000000]                  mov bl , [a]
    37 00000022 021D[03000000]                  add bl , [d] ; bl = a + d
    38                                         
    39 00000028 F6F3                            div bl ; al = ax / bl  ; ah = ax % b
    40                                                 ; al = (b*c - (e + f) ) /  (a+d)
    41                                          
    42                                          
    43                                          
    44                                          
    45                                          
    46                                          ; exit(0)
    47 0000002A 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    48 0000002C FF15[00000000]                  call    [exit]       ; call exit to terminate the program
