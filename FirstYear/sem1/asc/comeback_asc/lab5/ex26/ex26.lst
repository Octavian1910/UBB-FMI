     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  
     3                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     4                                  global start        
     5                                  
     6                                  ; declare external functions needed by our program
     7                                  extern exit               ; tell nasm that exit exists even if we won't be defining it
     8                                  import exit msvcrt.dll    ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     9                                                            ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
    10                                  
    11                                  ; our data is declared here (the variables needed by our program)
    12                                  segment data use32 class=data
    13                                      ; ...
    14                                      
    15 00000000 0104020308040905            s db 1, 4, 2, 3, 8, 4, 9, 5
    16                                      lens equ $-s
    17 00000008 80                          max_poz_pare db -128        ; cel mai mic
    18 00000009 7F                          min_poz_impare db 127       ; cel mai mare
    19                                  
    20                                      
    21                                      
    22                                  ; our code starts here
    23                                  segment code use32 class=code
    24                                      start:
    25                                          ; ...
    26                                          
    27                                          ;0 daca nu e 0
    28                                          ;1 daca e 0
    29                                          
    30 00000000 BE00000000                      mov esi , 0
    31 00000005 B908000000                      mov ecx,lens
    32                                          loops :
    33 0000000A 8A86[00000000]                      mov al,[s+esi]
    34 00000010 F7C601000000                        test esi,1 ; daca al impar => zero flag = 0 , rez != 0
    35 00000016 750F                                jnz e_impar
    36                                              
    37                                              ;e par
    38 00000018 3A05[08000000]                      cmp al,[max_poz_pare]
    39 0000001E 7E14                                jle final_loop ; nu trb actualizat
    40                                              
    41                                              ;trb actualizat
    42 00000020 A2[08000000]                        mov [max_poz_pare],al
    43 00000025 EB0D                                jmp final_loop
    44                                                 
    45                                       
    46                                              ;e impar
    47                                              e_impar:
    48 00000027 3A05[09000000]                          cmp al,[min_poz_impare]
    49 0000002D 7305                                    jae final_loop ; nu trb actualizat
    50                                  
    51                                                   ;daca trb actualizat
    52 0000002F A2[09000000]                             mov [min_poz_impare],al
    53                                  
    54                                                      
    55                                                 final_loop :
    56 00000034 46                                      inc esi
    57 00000035 E2D3                             loop loops
    58                                                  
    59                                      
    60                                          ; exit(0)
    61 00000037 6A00                            push    dword 0      ; push the parameter for exit onto the stack
    62 00000039 FF15[00000000]                  call    [exit]       ; call exit to terminate the program
