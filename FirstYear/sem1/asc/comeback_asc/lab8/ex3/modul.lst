     1                                  bits 32
     2                                  
     3                                  extern printf
     4                                  import printf msvcrt.dll
     5                                  
     6                                  
     7                                  segment data use 32 class=data
     8 00000000 00<rept>                rezultat1 times 100 db 0  ; cifre1+cifre2
     9 00000064 00<rept>                rezultat2 times 100 db 0  ; cifre2+cifre1
    10 000000C8 25730D0A00              format db "%s",13,10,0
    11                                  
    12                                  segment code use32 public code
    13                                  global concatenari
    14                                  
    15                                  concatenari:
    16 00000000 8B442408                    mov eax,[esp+8];sir1
    17 00000004 8B5C2404                    mov ebx,[esp+4] ;sir2
    18                                      
    19 00000008 89C6                        mov esi,eax
    20 0000000A BF[00000000]                mov edi,rezultat1
    21 0000000F FC                          cld  ;st la dr
    22                                      
    23                                      loop_sir_1:      ;sir1+sir2
    24 00000010 AC                              lodsb  ; al = esi
    25 00000011 3C00                            cmp al,0
    26 00000013 740B                            je terminare_loop_sir_1
    27 00000015 3C30                            cmp al,'0'
    28 00000017 72F7                            jb loop_sir_1
    29 00000019 3C39                            cmp al,'9'
    30 0000001B 77F3                            ja loop_sir_1
    31                                          
    32 0000001D AA                              stosb ;incarca in al ce e in edi
    33 0000001E EBF0                        jmp loop_sir_1
    34                                      
    35                                      terminare_loop_sir_1:
    36 00000020 89DE                        mov esi,ebx
    37                                      loop_sir_2: 
    38 00000022 AC                              lodsb  ; al = esi
    39 00000023 3C00                            cmp al,0
    40 00000025 740B                            je afisare
    41 00000027 3C30                            cmp al,'0'
    42 00000029 72F7                            jb loop_sir_2
    43 0000002B 3C39                            cmp al,'9'
    44 0000002D 77F3                            ja loop_sir_2
    45 0000002F AA                              stosb
    46 00000030 EBF0                        jmp loop_sir_2
    47                                      
    48                                     
    49                                      
    50                                      afisare:
    51                                      ;terminare sir concatenat
    52 00000032 B000                        mov al,0
    53 00000034 AA                          stosb
    54                                      
    55                                      ;printf(format,sir_concatenat)
    56 00000035 68[00000000]                push rezultat1
    57 0000003A 68[C8000000]                push format
    58 0000003F FF15[00000000]              call [printf]
    59 00000045 83C408                      add esp, 4*2
    60                                           
    61 00000048 C20800                      ret 4*2
