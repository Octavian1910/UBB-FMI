     1                                  bits 32 ; assembling for the 32 bits architecture
     2                                  ; declare the EntryPoint (a label defining the very first instruction of the program)
     3                                  global start        
     4                                  ;a-(7+x)/(b*b-c/d+2); a-doubleword; b,c,d-byte; x-qword cu semn
     5                                  ; declare external functions needed by our program
     6                                  extern exit            ; tell nasm that exit exists even if we won't be defining it
     7                                  import exit msvcrt.dll ; exit is a function that ends the calling process. It is defined in msvcrt.dll
     8                                                         ; msvcrt.dll contains exit, printf and all the other important C-runtime specific functions
     9                                  ; our data is declared here (the variables needed by our program)
    10                                  segment data use32 class=data
    11 00000000 E8030000                    a dd 1000          ; a = 1000 (doubleword)
    12 00000004 05                          b db 5             ; b = 5 (byte)
    13 00000005 14                          c db 20            ; c = 20 (byte)
    14 00000006 04                          d db 4             ; d = 4 (byte)
    15 00000007 6400000000000000            x dq 100           ; x = 100 (qword)
    16 0000000F <res 00000004>              rezultat resd 1    ; variabilă pentru rezultat
    17                                      
    18                                  ; our code starts here
    19                                  segment code use32 class=code
    20                                      start:
    21 00000000 A0[04000000]                    mov al, [b]     ; AL = b = 5
    22 00000005 F62D[04000000]                  imul byte [b]    ; AX = b*b = 25
    23                                          
    24 0000000B 0FBFD8                          movsx ebx, ax   ; EBX = b*b = 25
    25                                          
    26 0000000E 66B80000                        mov ax, 0      
    27 00000012 A0[05000000]                    mov al, [c]     ; AL = c = 20
    28 00000017 F63D[06000000]                  idiv byte [d]    ; AL = c/d = 5
    29                                          
    30 0000001D 0FBEC8                          movsx ecx, al   ; ECX = c/d = 5
    31                                          
    32 00000020 29CB                            sub ebx, ecx    ; EBX = b*b - c/d = 20
    33 00000022 83C302                          add ebx, 2      ; EBX = b*b - c/d + 2 = 22
    34                                   
    35 00000025 A1[07000000]                    mov eax, [x]    ; EAX partea low a lui x = 100
    36 0000002A 8B15[0B000000]                  mov edx, [x+4]  ; EDX partea high a lui x = 0
    37                                          
    38 00000030 83C007                          add eax, 7      ; eax = a + 7 = 107
    39 00000033 83D200                          adc edx, 0      ; edx = edx + CF
    40                                         
    41 00000036 F7F3                            div ebx         ; eax = 4 
    42                                          
    43 00000038 8B0D[00000000]                  mov ecx, [a]    ; ECX = a = 1000
    44 0000003E 29C1                            sub ecx, eax    ; ECX = 1000 - 4 = 996
    45                                  
    46 00000040 890D[0F000000]                  mov [rezultat], ecx ; ecx = 996 = 000003E4h
    47                                          
    48                                          ; exit(0)
    49 00000046 6A00                            push dword 0
    50 00000048 FF15[00000000]                  call [exit]
